# WinAgent credentials, read by setup-windows.cmd / setup-windows.ps1 and scripts\install.ps1.
#
# 1. Copy this file to "credentials.env" in the same folder (the project folder, or the folder
#    where you put setup-windows.cmd on a new computer).
# 2. Fill in the values below. Do not use quotes.
# 3. Run the setup. credentials.env is git-ignored: it is never committed or uploaded.
#
# After the first successful install you may delete MYSQL_ROOT_PASSWORD from this file; it is
# only needed to create (or repair) the database user. Updates and normal runs do not need it.

# REQUIRED for the first install.
# - New computer without MySQL: the setup installs MySQL and makes THIS the root password.
# - MySQL already installed: your existing MySQL root password.
MYSQL_ROOT_PASSWORD=
