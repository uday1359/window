# Copy to ai-service/.env (git-ignored) or generate it with: npm run setup:env
AI_HOST=127.0.0.1
AI_PORT=8710
# Must equal AI_SERVICE_TOKEN in server/.env
AI_SERVICE_TOKEN=<random>
OLLAMA_URL=http://127.0.0.1:11434
# Cloud API keys are stored here, encrypted with Windows DPAPI (never in MySQL)
# Relative to the project folder.
SECRET_STORE_PATH=data/secrets.dpapi
