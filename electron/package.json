{
  "name": "@winagent/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "WinAgent desktop shell (reuses the web dashboard)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "typescript": "5.9.2"
  },
  "build": {
    "appId": "local.winagent.desktop",
    "productName": "WinAgent",
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false
    }
  }
}
