# Copy to server/.env (git-ignored) or generate it with: npm run setup:env
NODE_ENV=development
HOST=127.0.0.1
PORT=3710
DATABASE_URL=mysql://winagent:<password>@127.0.0.1:3306/winagent
SHADOW_DATABASE_URL=mysql://winagent:<password>@127.0.0.1:3306/winagent_shadow
TEST_DATABASE_URL=mysql://winagent:<password>@127.0.0.1:3306/winagent_test
AI_SERVICE_URL=http://127.0.0.1:8710
# Shared secret between server and AI service (>= 32 random characters; same value in ai-service/.env)
AI_SERVICE_TOKEN=<random>
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
WEB_ORIGIN=http://127.0.0.1:5173
# Paths may be relative to the project folder (recommended).
STORAGE_DIR=storage
BACKUP_DIR=backups
# Local file for writes made while MySQL is unavailable (replayed automatically):
# OFFLINE_QUEUE_FILE=data/offline-queue.jsonl
# MYSQL_BIN_DIR is found automatically (newest MySQL Server in the Program Files folder); set it only to override.
# Optional
# APPROVAL_TTL_MINUTES=30
# OPERATION_TIMEOUT_MS=120000
# ORCHESTRATOR_TICK_MS=1000
# LOGIN_RATE_LIMIT_PER_MIN=10
# WEB_DIST_DIR=web/dist
# Optional TLS for agents/browsers on other computers (scripts\new-tls-cert.ps1 sets these).
# Without TLS the server refuses to listen on anything but 127.0.0.1.
# TLS_PFX_FILE=data/tls/server.pfx
# TLS_PFX_PASSPHRASE=<random>
# or PEM files instead of PFX:
# TLS_CERT_FILE=data/tls/cert.pem
# TLS_KEY_FILE=data/tls/key.pem
# PUBLIC_ORIGIN=https://winagent.example.com:3710
